# Copiar a /etc/whitebird-control-panel.env, propietario root, modo 0600.
# La comprobación de despliegue usa el puerto 3080.
PANEL_PORT=3080
PANEL_ENV_PATH=/opt/whitebird-wow-role-sync/.env
PANEL_RECRUITMENT_ENV_PATH=/opt/whitebird-recruitment-bot/.env
PANEL_ROULETTE_ENV_PATH=/opt/whitebird-wow-wheel/.env

# Permite recrear los servicios Compose de los bots desde el panel.
PANEL_RESTART_ENABLED=true

# Ajustar a los EnvironmentFile reales de los servicios IA y Discord.
PANEL_AGENT_ENV_PATH=/home/ubuntu/whitebird/shared/agent.env
PANEL_AGENT_DISCORD_ENV_PATH=/home/ubuntu/whitebird/shared/discord.env
# Conexión del chat: mismo secreto que AGENT_API_TOKEN (mínimo 32 caracteres).
# PANEL_AGENT_URL=http://127.0.0.1:3090
# PANEL_AGENT_TOKEN=
