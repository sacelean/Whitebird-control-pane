[Unit]
Description=Whitebird Control Panel
After=network.target

[Service]
Type=simple
User=whitebird-panel
Group=whitebird-panel
WorkingDirectory=/opt/whitebird-control-panel/current
EnvironmentFile=/etc/whitebird-control-panel.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
