# Configuración del panel; las rutas relativas se resuelven desde su directorio de ejecución.
PANEL_PORT=3080
PANEL_ENV_PATH=../whitebird-wow-role-sync/.env
PANEL_RECRUITMENT_ENV_PATH=../whitebird-recruitment-bot/.env
PANEL_ROULETTE_ENV_PATH=../whitebird-wow-wheel/.env

# Permite recrear los servicios Compose de los bots desde el panel.
PANEL_RESTART_ENABLED=true

# Archivos existentes del agente IA y de su adaptador Discord (separados).
PANEL_AGENT_ENV_PATH=../whitebird-ai-agent/.env
PANEL_AGENT_DISCORD_ENV_PATH=../whitebird-ai-agent/discord.env
# Conexión del chat: el token debe coincidir con AGENT_API_TOKEN (mínimo 32 caracteres).
# PANEL_AGENT_URL=http://127.0.0.1:3090
# PANEL_AGENT_TOKEN=
